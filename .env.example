# ── Cloudflare R2（双桶架构）──
# 1. https://dash.cloudflare.com → R2 → 创建两个桶
#    公开桶: weacond-public（预览、封面、index.json）
#    私有桶: weacond-private（完整内容、PDF/EPUB）
# 2. 公开桶启用 "Public access" 或绑定自定义域名
# 3. 私有桶关闭 "Public access"
# 4. 创建 API Token（R2 scope, read+write）
R2_PUBLIC_URL=https://weacond-public.r2.cloudflarestorage.com
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_API_TOKEN=your-r2-api-token
R2_PRIVATE_BUCKET=weacond-private

# ── Supabase（用户 + 购买记录）──
# 1. https://supabase.com → New Project
# 2. 在 SQL Editor 中执行 supabase/schema.sql
# 3. 复制 API 密钥
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe（支付）──
# 1. 动态定价：无需在 Stripe 后台建产品，价格写在 lib/stripe.js
# 2. 复制 API 密钥
# 3. 创建 Webhook: https://weacond.com/api/checkout/webhook
#    事件: checkout.session.completed, invoice.payment_failed
STRIPE_SECRET_KEY=sk_test_your_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── 站点 ──
NEXT_PUBLIC_SITE_URL=https://weacond.com

# ── 本地 AI（WebGPU，可选）──
NEXT_PUBLIC_MODEL_URL=
NEXT_PUBLIC_USE_WEB_PUSH=false
NEXT_PUBLIC_VAPID_PUBLIC_KEY=